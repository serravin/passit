# Local demo uses fixed fictional accounts and a deterministic creative adapter.
PASSIT_MODE=demo
PASSIT_DATABASE_URL=sqlite:///./passit.db
PASSIT_ORIGIN=http://localhost:5173
# Production: set PASSIT_MODE=production, PostgreSQL, and your OIDC configuration.
# PASSIT_OIDC_ISSUER=https://your-tenant.example.com/
# PASSIT_OIDC_AUDIENCE=your-api-client-id
# PASSIT_OIDC_JWKS_URL=https://your-tenant.example.com/discovery/keys
# PASSIT_ADMIN_SUBJECTS=admin-subject-id
# PASSIT_AI_ALLOWED_HOSTS=your-resource.openai.azure.com
# PASSIT_AI_ENDPOINT=https://your-resource.openai.azure.com
# PASSIT_AI_DEPLOYMENT=your-deployment
# PASSIT_AI_MODEL=your-model-version
# PASSIT_AI_API_VERSION=2024-10-21
# PASSIT_AI_API_KEY is optional; managed identity is the default Azure credential.
# Validate profiles in Admin, then activate creative default and guardrail explicitly.
# Both API and worker need the guardrail's credential reference or managed identity access.
# The demo guardrail recognizes only [[demo:bullying]], not real inappropriate content.
